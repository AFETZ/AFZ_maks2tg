# Max credentials (DevTools → Application → Local Storage → web.max.ru)
MAX_TOKEN=
MAX_DEVICE_ID=

# Optional: comma-separated Max chat IDs. Empty means all chats.
# MAX_CHAT_IDS=-123,-456

# Telegram (create a bot with @BotFather and send it /start before launch)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Optional SOCKS5 proxy for Telegram
# TG_PROXY=socks5://127.0.0.1:1080

# Telegram HTTP timeouts in seconds
TG_READ_TIMEOUT=30
TG_WRITE_TIMEOUT=30
TG_MEDIA_WRITE_TIMEOUT=120

# Docker network mode. Use host on Linux only when accessing a proxy bound to
# the host loopback interface (for example, 127.0.0.1:1080).
DOCKER_NETWORK_MODE=bridge

# Runtime options (true/false)
DEBUG=false
REPLY_ENABLED=false
